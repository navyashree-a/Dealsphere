# Copy this file to .env.local and fill in your values. .env.local is gitignored.
#
# "Sign in with Google" reads its Client ID from GOOGLE_CLIENT_ID in
# wrangler.toml (website and server). Set this only to try a different Client
# ID locally. The Client ID is public configuration, not a secret. Never put a
# Client SECRET or any API key in this project.
VITE_GOOGLE_CLIENT_ID=

# "Continue with WhatsApp" uses this site's own backend (/api) by default.
# Only set this to use a different sign-in server.
VITE_OTP_API_URL=

# Pinnacle (WhatsApp Business) settings for the LOCAL dev server only - the
# live site reads them from wrangler.toml and the PINNACLE_API_KEY secret.
# Leave empty to get a labelled on-screen demo code instead of a real message.
# Never commit the API key: keep it in .env.local (gitignored).
PINNACLE_API_URL=https://partnersv1.pinbot.ai
PINNACLE_WABA_NUMBER_ID=
PINNACLE_API_KEY=
PINNACLE_OTP_TEMPLATE=
PINNACLE_OTP_LANGUAGE=en
