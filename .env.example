# Copy this file to .env.local and fill in your values. .env.local is gitignored.
#
# Google OAuth Client ID for "Sign in with Google" (customer sign-in).
# Create one at https://console.cloud.google.com/apis/credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   -> Authorized JavaScript origins: http://localhost:5173 (and your live domain)
# The Client ID is public configuration, not a secret. Never put a Client
# SECRET or any API key in this frontend.
VITE_GOOGLE_CLIENT_ID=

# Backend base URL for "Continue with WhatsApp" (OTP sign-in). Leave empty to
# use the labelled demo mode (no WhatsApp message is sent; the code is shown on
# screen). The backend must expose POST /otp/whatsapp/send and
# /otp/whatsapp/verify - see src/auth/whatsappOtp.js. The WhatsApp Cloud API
# access token belongs on that server, never in this file.
VITE_OTP_API_URL=
